<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFrameworks>$(FreeKitTargetFrameworks)</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FreeSql.Provider.Sqlite" Version="$(DefaultFreeSqlVersion)" />
		<PackageReference Include="FreeSql.Provider.MySqlConnector" Version="$(DefaultFreeSqlVersion)" />
		<PackageReference Include="FreeSql.Provider.MySql" Version="$(DefaultFreeSqlVersion)" />
		<PackageReference Include="FreeSql.Provider.SqlServer" Version="$(DefaultFreeSqlVersion)" />
		<PackageReference Include="FreeSql.Provider.PostgreSQL" Version="$(DefaultFreeSqlVersion)" />
		<PackageReference Include="FreeSql.Provider.Oracle" Version="$(DefaultFreeSqlVersion)" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(FreeKitAppAspNetCoreVersion)" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.5" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="$(FreeKitAppAspNetCoreVersion)" />
		<PackageReference Include="Xunit.DependencyInjection" Version="11.2.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\IGeekFan.AspNetCore.DataProtection.FreeSql\IGeekFan.AspNetCore.DataProtection.FreeSql.csproj" />
		<ProjectReference Include="..\..\src\IGeekFan.FreeKit.Modularity\IGeekFan.FreeKit.Modularity.csproj" />
		<ProjectReference Include="..\Module1\Module1.csproj" />
		<ProjectReference Include="..\Module2\Module2.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == '$(DefaultNetCoreTargetFrameworkVersion11)'">
		<PackageReference Update="Swashbuckle.AspNetCore" Version="11.0.1" />
	</ItemGroup>
</Project>
