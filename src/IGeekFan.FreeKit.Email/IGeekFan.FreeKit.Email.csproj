<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(DefaultNetCoreTargetFrameworkVersion8);$(DefaultNetCoreTargetFrameworkVersion10);$(DefaultNetCoreTargetFrameworkVersion11)</TargetFrameworks>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MailKit" Version="4.18.1" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
		<PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == '$(DefaultNetCoreTargetFrameworkVersion11)'">
		<PackageReference Update="System.Security.Cryptography.Pkcs" Version="11.0.0" />
		<PackageReference Update="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0" />
		<PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
		<PackageReference Update="Microsoft.Extensions.Options" Version="11.0.0" />
		<PackageReference Update="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
	</ItemGroup>
</Project>
